<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>ทำประกันOnline | FWD</title>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700;800&family=Prompt:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --o:#FF6200;--o2:#FF8534;--dark:#0F0F0F;--ch:#1E1E1E;
  --bdr:rgba(255,255,255,0.08);--txt:#F0F0F0;--mut:rgba(255,255,255,0.45);
  --wh:#FFFFFF;--grn:#22C55E;--red:#EF4444;
  --gold:#D4A017;--glight:rgba(212,160,23,0.12);
  --teal:#0D9488;--tlight:rgba(13,148,136,0.12);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html{scroll-behavior:smooth;}
body{background:var(--dark);font-family:'Sarabun',sans-serif;color:var(--txt);min-height:100vh;overflow-x:hidden;}

/* HEADER */
.hdr{background:var(--ch);border-bottom:1px solid var(--bdr);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;}
.logo{font-family:'Prompt',sans-serif;font-weight:900;font-size:19px;color:var(--o);line-height:1;}
.logo sub{display:block;font-size:8px;font-weight:400;letter-spacing:1.5px;color:var(--mut);margin-top:1px;}
.hdr-r{font-size:10px;color:var(--mut);text-align:right;}

/* TABS - 3 columns */
.tabs{display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--ch);border-bottom:1px solid var(--bdr);}
.tab-btn{padding:12px 6px;font-family:'Prompt',sans-serif;font-weight:700;font-size:11px;border:none;background:transparent;color:var(--mut);cursor:pointer;border-bottom:3px solid transparent;transition:all .2s;text-align:center;line-height:1.4;}
.tab-btn.t-ci{color:var(--o);border-bottom-color:var(--o);}
.tab-btn.t-leg{color:var(--gold);border-bottom-color:var(--gold);}
.tab-btn.t-pc{color:var(--teal);border-bottom-color:var(--teal);}

/* HERO */
.hero{padding:22px 18px 18px;position:relative;overflow:hidden;background:linear-gradient(135deg,#1A1A1A 0%,var(--dark) 100%);}
.hero::before{content:'';position:absolute;top:-70px;right:-70px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(255,98,0,0.13) 0%,transparent 65%);pointer-events:none;transition:background .4s;}
.hero.m-leg::before{background:radial-gradient(circle,rgba(212,160,23,0.13) 0%,transparent 65%);}
.hero.m-pc::before{background:radial-gradient(circle,rgba(13,148,136,0.13) 0%,transparent 65%);}
.eyebrow{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--o);margin-bottom:5px;transition:color .3s;}
.hero.m-leg .eyebrow{color:var(--gold);}
.hero.m-pc .eyebrow{color:var(--teal);}
.htitle{font-family:'Prompt',sans-serif;font-weight:800;font-size:22px;color:var(--wh);line-height:1.2;margin-bottom:4px;}
.htitle em{color:var(--o);font-style:normal;transition:color .3s;}
.hero.m-leg .htitle em{color:var(--gold);}
.hero.m-pc .htitle em{color:var(--teal);}
.hdesc{font-size:12px;color:var(--mut);line-height:1.6;max-width:320px;}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px;}
.chip{background:rgba(255,98,0,0.1);border:1px solid rgba(255,98,0,0.25);border-radius:20px;padding:3px 10px;font-size:10px;color:var(--o2);transition:all .3s;}
.hero.m-leg .chip{background:var(--glight);border-color:rgba(212,160,23,0.25);color:var(--gold);}
.hero.m-pc .chip{background:var(--tlight);border-color:rgba(13,148,136,0.25);color:var(--teal);}

/* FORM */
.form-sec{padding:18px;background:var(--ch);margin:12px;border-radius:16px;border:1px solid var(--bdr);}
.ftitle{font-family:'Prompt',sans-serif;font-weight:700;font-size:14px;color:var(--wh);margin-bottom:14px;}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:11px;}
.fg{display:flex;flex-direction:column;gap:4px;}
.flabel{font-size:9px;color:var(--mut);letter-spacing:1.5px;text-transform:uppercase;font-weight:700;}
.finput,.fselect{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:11px 13px;font-size:15px;font-family:'Sarabun',sans-serif;color:var(--wh);width:100%;transition:border-color .2s;-webkit-appearance:none;}
.finput:focus,.fselect:focus{outline:none;border-color:var(--o);background:rgba(255,98,0,0.06);}
.fselect option{background:#1E1E1E;color:var(--wh);}

/* GENDER */
.gen{display:grid;grid-template-columns:1fr 1fr;gap:7px;}
.gbtn{background:rgba(255,255,255,0.05);border:1.5px solid rgba(255,255,255,0.1);border-radius:10px;padding:10px;font-size:13px;font-family:'Sarabun',sans-serif;color:var(--mut);cursor:pointer;transition:all .2s;text-align:center;}
.gbtn.g-ci{background:rgba(255,98,0,0.12);border-color:var(--o);color:var(--o);font-weight:700;}
.gbtn.g-leg{background:var(--glight);border-color:var(--gold);color:var(--gold);font-weight:700;}
.gbtn.g-pc{background:var(--tlight);border-color:var(--teal);color:var(--teal);font-weight:700;}

/* AMOUNT BTNS */
.amts{display:flex;gap:5px;flex-wrap:wrap;margin-top:3px;}
.abtn{background:rgba(255,255,255,0.04);border:1.5px solid rgba(255,255,255,0.08);border-radius:8px;padding:6px 10px;font-size:11px;font-family:'Sarabun',sans-serif;color:var(--mut);cursor:pointer;transition:all .2s;white-space:nowrap;}
.abtn.a-ci{background:rgba(255,98,0,0.12);border-color:var(--o);color:var(--o);font-weight:700;}
.abtn.a-leg{background:var(--glight);border-color:var(--gold);color:var(--gold);font-weight:700;}
.abtn.a-pc{background:var(--tlight);border-color:var(--teal);color:var(--teal);font-weight:700;}

/* SEARCH BTN */
.sbtn{width:100%;color:white;border:none;border-radius:12px;padding:14px;font-size:15px;font-family:'Prompt',sans-serif;font-weight:700;cursor:pointer;margin-top:14px;transition:transform .15s;letter-spacing:.5px;}
.sbtn:active{transform:scale(.97);}
.sbtn.s-ci{background:var(--o);}
.sbtn.s-leg{background:linear-gradient(135deg,var(--gold),#9A7015);}
.sbtn.s-pc{background:linear-gradient(135deg,var(--teal),#065F56);}

/* LOADING */
.loading{display:none;text-align:center;padding:18px;color:var(--mut);font-size:13px;}
.spinner{width:24px;height:24px;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 8px;}
.sp-ci{border:2px solid rgba(255,98,0,.2);border-top-color:var(--o);}
.sp-leg{border:2px solid rgba(212,160,23,.2);border-top-color:var(--gold);}
.sp-pc{border:2px solid rgba(13,148,136,.2);border-top-color:var(--teal);}
@keyframes spin{to{transform:rotate(360deg);}}

/* NO RESULT */
.nores{display:none;padding:20px;text-align:center;background:var(--ch);border-radius:16px;border:1px solid var(--bdr);margin:0 12px 12px;}
.nores-icon{font-size:28px;margin-bottom:7px;}
.nores-txt{font-size:13px;color:var(--mut);line-height:1.6;}

/* RESULT */
.res-sec{margin:0 12px 12px;display:none;}
.res-sec.show{display:block;}
.res-card{background:var(--ch);border-radius:16px;border:1px solid var(--bdr);overflow:hidden;animation:slideUp .4s ease-out;}
@keyframes slideUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}
.res-hdr{padding:16px 18px;position:relative;overflow:hidden;}
.res-hdr::after{content:'';position:absolute;top:-20px;right:-20px;width:90px;height:90px;border-radius:50%;background:rgba(255,255,255,0.07);}
.rh-ci{background:linear-gradient(135deg,var(--o) 0%,#C94400 100%);}
.rh-leg{background:linear-gradient(135deg,#C9952A 0%,#8B6914 100%);}
.rh-pc{background:linear-gradient(135deg,#0D9488 0%,#065F56 100%);}
.r-plan{font-family:'Prompt',sans-serif;font-weight:800;font-size:16px;color:white;line-height:1.2;margin-bottom:2px;position:relative;z-index:1;}
.r-for{font-size:11px;color:rgba(255,255,255,.75);position:relative;z-index:1;}

.pdisp{padding:16px 18px;border-bottom:1px solid var(--bdr);}
.prow{display:flex;justify-content:space-between;align-items:flex-end;}
.plbl{font-size:9px;color:var(--mut);letter-spacing:1px;text-transform:uppercase;margin-bottom:3px;}
.pval{font-family:'Prompt',sans-serif;font-size:32px;font-weight:900;line-height:1;}
.pval span{font-size:12px;font-weight:400;color:var(--mut);margin-left:2px;}
.pval-ci{color:var(--o);}
.pval-leg{color:var(--gold);}
.pval-pc{color:var(--teal);}
.pmo{font-size:11px;color:var(--mut);margin-top:2px;}
.pr{text-align:right;}
.psub{font-family:'Prompt',sans-serif;font-size:16px;font-weight:800;color:var(--wh);}

.dgrid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--bdr);border-bottom:1px solid var(--bdr);}
.dcell{background:var(--ch);padding:11px 14px;}
.dl{font-size:9px;color:var(--mut);letter-spacing:1px;text-transform:uppercase;margin-bottom:2px;}
.dv{font-family:'Prompt',sans-serif;font-size:13px;font-weight:700;color:var(--wh);}
.dv-ci{color:var(--o);}
.dv-leg{color:var(--gold);}
.dv-pc{color:var(--teal);}

.covs{padding:13px 18px;border-bottom:1px solid var(--bdr);}
.covt{font-size:9px;color:var(--mut);letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;}
.covl{display:flex;flex-direction:column;gap:6px;}
.cov{display:flex;gap:8px;align-items:flex-start;font-size:12px;color:var(--txt);line-height:1.5;}
.ck{width:15px;height:15px;background:rgba(34,197,94,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:8px;flex-shrink:0;margin-top:2px;color:var(--grn);}

.cta{padding:13px 18px;display:flex;flex-direction:column;gap:8px;}
.cbtn{width:100%;border-radius:10px;padding:13px;font-size:13px;font-family:'Prompt',sans-serif;font-weight:700;cursor:pointer;border:none;transition:transform .15s;letter-spacing:.5px;}
.cbtn:active{transform:scale(.97);}
.cb-ci{background:var(--o);color:white;}
.cb-leg{background:linear-gradient(135deg,var(--gold),#9A7015);color:white;}
.cb-pc{background:linear-gradient(135deg,var(--teal),#065F56);color:white;}
.cb-sec{background:rgba(255,255,255,.06);color:var(--wh);border:1px solid var(--bdr)!important;}
.cb-out-ci{background:transparent;color:var(--o);border:1.5px solid var(--o)!important;}
.cb-out-leg{background:transparent;color:var(--gold);border:1.5px solid var(--gold)!important;}
.cb-out-pc{background:transparent;color:var(--teal);border:1.5px solid var(--teal)!important;}

/* QR */
.qrsec{margin:0 12px 12px;background:var(--ch);border-radius:16px;border:1px solid var(--bdr);padding:20px 18px;text-align:center;}
.qrt{font-family:'Prompt',sans-serif;font-weight:700;font-size:14px;color:var(--wh);margin-bottom:4px;}
.qrs{font-size:11px;color:var(--mut);margin-bottom:16px;}
.qrw{width:140px;height:140px;background:white;border-radius:12px;margin:0 auto 13px;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:6px;}
.qrw img{width:100%;height:100%;object-fit:contain;}
.lbtn{display:inline-flex;align-items:center;gap:6px;background:#06C755;color:white;border:none;border-radius:10px;padding:11px 20px;font-size:13px;font-family:'Prompt',sans-serif;font-weight:700;cursor:pointer;text-decoration:none;transition:opacity .2s;}

/* MODAL */
.mov{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:200;display:none;align-items:flex-end;backdrop-filter:blur(4px);}
.mov.show{display:flex;}
.modal{background:#1A1A1A;border-radius:20px 20px 0 0;width:100%;max-height:90vh;overflow-y:auto;padding:0 0 40px;animation:slideModal .35s cubic-bezier(.32,.72,0,1);}
@keyframes slideModal{from{transform:translateY(100%);}to{transform:translateY(0);}}
.mhandle{width:36px;height:4px;background:rgba(255,255,255,.2);border-radius:2px;margin:12px auto 0;}
.mhead{padding:16px 18px 12px;border-bottom:1px solid var(--bdr);display:flex;justify-content:space-between;align-items:center;}
.mtitle{font-family:'Prompt',sans-serif;font-weight:700;font-size:16px;color:var(--wh);}
.mclose{background:rgba(255,255,255,.08);border:none;width:28px;height:28px;border-radius:50%;font-size:15px;color:var(--mut);cursor:pointer;display:flex;align-items:center;justify-content:center;}
.mbody{padding:16px 18px;}
.mg{margin-bottom:12px;}
.ml{font-size:10px;color:var(--mut);letter-spacing:1px;text-transform:uppercase;font-weight:700;margin-bottom:6px;display:block;}
.mi,.ms,.mta{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:11px 13px;font-size:14px;font-family:'Sarabun',sans-serif;color:var(--wh);transition:border-color .2s;}
.mta{min-height:70px;resize:none;}
.mi:focus,.ms:focus,.mta:focus{outline:none;border-color:var(--o);}
.ms option{background:#1A1A1A;}
.msub{width:100%;background:var(--o);color:white;border:none;border-radius:12px;padding:14px;font-size:14px;font-family:'Prompt',sans-serif;font-weight:700;cursor:pointer;margin-top:5px;}
.ss{text-align:center;padding:34px 18px;display:none;}
.si{width:56px;height:56px;background:rgba(34,197,94,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 12px;}
.st{font-family:'Prompt',sans-serif;font-weight:700;font-size:18px;color:var(--wh);margin-bottom:6px;}
.sd{font-size:12px;color:var(--mut);line-height:1.6;}

.errtxt{font-size:10px;color:var(--red);margin-top:3px;display:none;}
input.err,select.err{border-color:var(--red)!important;}

.footer{padding:20px 18px 40px;text-align:center;border-top:1px solid var(--bdr);margin-top:6px;}
.flogo{font-family:'Prompt',sans-serif;font-weight:900;font-size:16px;color:var(--o);margin-bottom:4px;}
.ftxt{font-size:10px;color:var(--mut);line-height:1.7;}
</style>
</head>
<body>

<div class="hdr">
  <div><div class="logo">FWD<sub>ทำประกันOnline</sub></div></div>
  <div class="hdr-r">Agent Code<br><strong style="color:var(--o)">162165</strong></div>
</div>

<!-- 3 TABS -->
<div class="tabs">
  <button class="tab-btn t-ci" id="tabCI" onclick="sw('ci')">💊 CI<br>โรคร้ายแรง</button>
  <button class="tab-btn" id="tabLeg" onclick="sw('leg')">🏆 มรดก<br>Dragon</button>
  <button class="tab-btn" id="tabPC" onclick="sw('pc')">🏥 พรีเชียส<br>แคร์</button>
</div>

<!-- HERO -->
<div class="hero" id="heroEl">
  <div class="eyebrow">เช็คเบี้ยประกัน</div>
  <div class="htitle" id="htitle">โรคร้ายแรง<br><em>CI Re-Claim Re-Care</em></div>
  <div class="hdesc" id="hdesc">กรอกข้อมูลเพื่อดูเบี้ยประกันที่เหมาะกับคุณ ภายใน 3 วินาที</div>
  <div class="chips" id="hchips">
    <div class="chip">✅ เบี้ยจริง</div>
    <div class="chip">🔒 ปลอดภัย</div>
    <div class="chip">⚡ ทันที</div>
  </div>
</div>

<!-- FORM -->
<div class="form-sec">
  <div class="ftitle" id="ftitle">🔍 ค้นหาเบี้ยประกัน CI</div>
  <div class="frow">
    <div class="fg">
      <label class="flabel">อายุ (ปี)</label>
      <input type="number" id="inAge" class="finput" placeholder="เช่น 35" min="1" max="75">
      <div class="errtxt" id="ageErr">กรุณากรอกอายุให้ถูกต้อง</div>
    </div>
    <div class="fg">
      <label class="flabel">เพศ</label>
      <div class="gen">
        <button class="gbtn g-ci" id="btnM" onclick="setG('male')">👨 ชาย</button>
        <button class="gbtn" id="btnF" onclick="setG('female')">👩 หญิง</button>
      </div>
    </div>
  </div>

  <!-- CI -->
  <div id="secCI" class="fg" style="margin-bottom:12px">
    <label class="flabel">ทุน CI Re-Claim</label>
    <div class="amts" id="ciAmts">
      <button class="abtn" onclick="pick('ci',500000,this)">500K</button>
      <button class="abtn" onclick="pick('ci',1000000,this)">1M</button>
      <button class="abtn a-ci" onclick="pick('ci',3000000,this)">3M</button>
      <button class="abtn" onclick="pick('ci',5000000,this)">5M</button>
      <button class="abtn" onclick="pick('ci',6000000,this)">6M</button>
      <button class="abtn" onclick="pick('ci',7000000,this)">7M</button>
      <button class="abtn" onclick="pick('ci',8000000,this)">8M</button>
      <button class="abtn" onclick="pick('ci',9000000,this)">9M</button>
      <button class="abtn" onclick="pick('ci',10000000,this)">10M</button>
    </div>
  </div>

  <!-- LEGACY -->
  <div id="secLeg" class="fg" style="margin-bottom:12px;display:none">
    <label class="flabel">ทุนประกันมรดก</label>
    <div class="amts" id="legAmts">
      <button class="abtn" onclick="pick('leg',1000000,this)">1 ล้าน</button>
      <button class="abtn a-leg" onclick="pick('leg',2000000,this)">2 ล้าน</button>
      <button class="abtn" onclick="pick('leg',3000000,this)">3 ล้าน</button>
      <button class="abtn" onclick="pick('leg',5000000,this)">5 ล้าน</button>
    </div>
  </div>

  <!-- PRECIOUS CARE -->
  <div id="secPC" class="fg" style="margin-bottom:12px;display:none">
    <label class="flabel">วงเงินเหมาจ่าย/ปี</label>
    <div class="amts" id="pcAmts">
      <button class="abtn" onclick="pick('pc',1000000,this)">1 ล้าน</button>
      <button class="abtn a-pc" onclick="pick('pc',3000000,this)">3 ล้าน</button>
      <button class="abtn" onclick="pick('pc',6000000,this)">6 ล้าน</button>
      <button class="abtn" onclick="pick('pc',12000000,this)">12 ล้าน</button>
    </div>
  </div>

  <button class="sbtn s-ci" id="sbtn" onclick="doSearch()">🔍 ดูเบี้ยประกัน</button>
</div>

<div class="loading" id="loadEl"><div class="spinner sp-ci" id="spinEl"></div>กำลังค้นหาข้อมูล...</div>
<div class="nores" id="noresEl"><div class="nores-icon">😔</div><div class="nores-txt">ไม่พบข้อมูล<br>กรุณาติดต่อเอเจนต์โดยตรงครับ</div></div>

<!-- RESULT -->
<div class="res-sec" id="resSec">
  <div class="res-card">
    <div class="res-hdr rh-ci" id="rHdr">
      <div class="r-plan" id="rPlan">-</div>
      <div class="r-for" id="rFor">-</div>
    </div>
    <div class="pdisp">
      <div class="prow">
        <div>
          <div class="plbl">เบี้ยประกันรายปี</div>
          <div class="pval pval-ci" id="rPrem">-<span>บาท/ปี</span></div>
          <div class="pmo" id="rMo">-</div>
        </div>
        <div class="pr">
          <div class="plbl" id="rSumLbl">ทุน CI</div>
          <div class="psub" id="rSum">-</div>
        </div>
      </div>
    </div>
    <div class="dgrid">
      <div class="dcell"><div class="dl">ทุนประกันชีวิต</div><div class="dv" id="rLife">-</div></div>
      <div class="dcell"><div class="dl" id="rExLbl">เคลมสูงสุด</div><div class="dv dv-ci" id="rEx">-</div></div>
      <div class="dcell"><div class="dl">คุ้มครองถึงอายุ</div><div class="dv" id="rCov">-</div></div>
      <div class="dcell"><div class="dl">รับประกัน</div><div class="dv" id="rAcc">-</div></div>
    </div>
    <div class="covs"><div class="covt">ความคุ้มครอง</div><div class="covl" id="covList"></div></div>
    <div class="cta">
      <button class="cbtn cb-ci" id="ctaLine" onclick="window.open('https://lin.ee/Wb0k43i','_blank')">💬 สนใจ — ส่งข้อความหาเอเจนต์</button>
      <button class="cbtn cb-out-ci" id="ctaAppt" onclick="openAppt()">📅 นัดหมายปรึกษาฟรี</button>
      <button class="cbtn cb-sec" onclick="showQR()">📱 ดู QR Code ติดต่อ</button>
    </div>
  </div>
</div>

<!-- QR -->
