let mode='ci', gender='male', ciAmt=3000000, legAmt=2000000, pcAmt=3000000;

function fmt(n){return n?n.toLocaleString('th-TH'):'0';}

// ── SWITCH TAB ──
function sw(m){
  mode=m;
  ['tabCI','tabLeg','tabPC'].forEach(id=>document.getElementById(id).className='tab-btn');
  if(m==='ci') document.getElementById('tabCI').className='tab-btn t-ci';
  else if(m==='leg') document.getElementById('tabLeg').className='tab-btn t-leg';
  else document.getElementById('tabPC').className='tab-btn t-pc';

  const h=document.getElementById('heroEl');
  h.className='hero'+(m==='leg'?' m-leg':m==='pc'?' m-pc':'');

  const titles={ci:'โรคร้ายแรง<br><em>CI Re-Claim Re-Care</em>',leg:'ประกันมรดก<br><em>Dragon Group · FWD</em>',pc:'ประกันสุขภาพ<br><em>พรีเชียส แคร์ โพรเทคชั่น</em>'};
  const descs={ci:'กรอกข้อมูลเพื่อดูเบี้ยประกัน CI ที่เหมาะกับคุณ',leg:'วางแผนส่งต่อมรดกให้ทายาท ด้วยประกันชีวิต FWD',pc:'เช็คเบี้ยสุขภาพเหมาจ่าย วงเงินสูงสุด 12 ล้าน/ปี'};
  const ftitles={ci:'🔍 ค้นหาเบี้ย CI โรคร้ายแรง',leg:'🔍 ค้นหาเบี้ยประกันมรดก',pc:'🔍 ค้นหาเบี้ยพรีเชียส แคร์'};

  document.getElementById('htitle').innerHTML=titles[m];
  document.getElementById('hdesc').textContent=descs[m];
  document.getElementById('ftitle').textContent=ftitles[m];
  document.getElementById('secCI').style.display=m==='ci'?'':'none';
  document.getElementById('secLeg').style.display=m==='leg'?'':'none';
  document.getElementById('secPC').style.display=m==='pc'?'':'none';

  const btnMap={ci:'s-ci',leg:'s-leg',pc:'s-pc'};
  document.getElementById('sbtn').className='sbtn '+btnMap[m];

  updateGen();
  hide();
}

function setG(g){gender=g;updateGen();}

function updateGen(){
  const ac={ci:'g-ci',leg:'g-leg',pc:'g-pc'};
  const cls=ac[mode]||'g-ci';
  document.getElementById('btnM').className='gbtn'+(gender==='male'?' '+cls:'');
  document.getElementById('btnF').className='gbtn'+(gender==='female'?' '+cls:'');
}

function pick(type,amt,el){
  if(type==='ci') ciAmt=amt;
  else if(type==='leg') legAmt=amt;
  else pcAmt=amt;
  const prefix=type==='ci'?'ci':type==='leg'?'leg':'pc';
  const clsMap={ci:'a-ci',leg:'a-leg',pc:'a-pc'};
  document.querySelectorAll('#'+prefix+'Amts .abtn').forEach(b=>b.classList.remove('a-ci','a-leg','a-pc'));
  el.classList.add(clsMap[type]);
}

function hide(){
  document.getElementById('resSec').classList.remove('show');
  document.getElementById('noresEl').style.display='none';
  document.getElementById('qrEl').style.display='none';
}

// ── SEARCH ──
function doSearch(){
  const age=parseInt(document.getElementById('inAge').value);
  const errEl=document.getElementById('ageErr');
  const maxA=mode==='leg'?65:mode==='pc'?75:70;
  const minA=mode==='leg'?20:mode==='pc'?20:1;
  if(!age||age<minA||age>maxA){
    errEl.textContent='กรุณากรอกอายุ '+minA+'-'+maxA+' ปี';
    errEl.style.display='block';
    document.getElementById('inAge').classList.add('err');
    return;
  }
  errEl.style.display='none';
  document.getElementById('inAge').classList.remove('err');
  document.getElementById('loadEl').style.display='block';
  document.getElementById('spinEl').className='spinner sp-'+mode;
  hide();

  setTimeout(()=>{
    document.getElementById('loadEl').style.display='none';
    let p=null;
    if(mode==='ci'){const d=CI[ciAmt];if(d&&d[age])p=gender==='male'?d[age].m:d[age].f;}
    else if(mode==='leg'){const d=LEG[legAmt];if(d)p=gender==='male'?d.m[age]:d.f[age];}
    else{const d=PC[pcAmt];if(d)p=gender==='male'?d.m[age]:d.f[age];}
    if(!p){document.getElementById('noresEl').style.display='block';return;}
    render(age,p);
  },600);
}

function render(age,prem){
  const mo=Math.ceil(prem/12);
  const g=gender==='male'?'ชาย':'หญิง';

  const hdrCls={ci:'rh-ci',leg:'rh-leg',pc:'rh-pc'};
  document.getElementById('rHdr').className='res-hdr '+hdrCls[mode];

  const pvCls={ci:'pval pval-ci',leg:'pval pval-leg',pc:'pval pval-pc'};
  document.getElementById('rPrem').className=pvCls[mode];
  document.getElementById('rPrem').innerHTML=fmt(prem)+'<span>บาท/ปี</span>';
  document.getElementById('rMo').textContent='≈ '+fmt(mo)+' บาท/เดือน';

  const exCls={ci:'dv dv-ci',leg:'dv dv-leg',pc:'dv dv-pc'};

  if(mode==='ci'){
    const cL=ciAmt>=1000000?(ciAmt/1000000)+' ล้าน':fmt(ciAmt);
    document.getElementById('rPlan').textContent='CI Re-Claim Re-Care Plus';
    document.getElementById('rFor').textContent=g+' อายุ '+age+' ปี';
    document.getElementById('rSumLbl').textContent='ทุน CI Re-Claim';
    document.getElementById('rSum').textContent=cL+' บาท';
    document.getElementById('rLife').textContent='200,000 ฿';
    document.getElementById('rExLbl').textContent='เคลมสูงสุด';
    document.getElementById('rEx').className=exCls.ci;
    document.getElementById('rEx').textContent=CI_MAX[ciAmt]||'-';
    document.getElementById('rCov').textContent='99 ปี';
    document.getElementById('rAcc').textContent='1-70 ปี';
    document.getElementById('covList').innerHTML=`
      <div class="cov"><div class="ck">✓</div><div>โรคร้ายแรง 50 โรค (มะเร็ง หัวใจ เส้นเลือดสมอง ฯลฯ)</div></div>
      <div class="cov"><div class="ck">✓</div><div>Re-Claim ได้ทุกปี ไม่หมดสิทธิ์</div></div>
      <div class="cov"><div class="ck">✓</div><div>Re-Care ดูแลสุขภาพหลังป่วยโรคร้าย</div></div>
      <div class="cov"><div class="ck">✓</div><div>ทุนชีวิต 200,000 บาท ถึงอายุ 99 ปี</div></div>`;
    document.getElementById('ctaLine').className='cbtn cb-ci';
    document.getElementById('ctaAppt').className='cbtn cb-out-ci';
  } else if(mode==='leg'){
    const lL=(legAmt/1000000)+' ล้านบาท';
    const ciB={1000000:'800,000',2000000:'1,800,000',3000000:'2,800,000',5000000:'4,800,000'}[legAmt]||'-';
    document.getElementById('rPlan').textContent='ประกันมรดก '+lL;
    document.getElementById('rFor').textContent=g+' อายุ '+age+' ปี';
    document.getElementById('rSumLbl').textContent='ทุนประกันชีวิต';
    document.getElementById('rSum').textContent=lL;
    document.getElementById('rLife').textContent=fmt(legAmt)+' ฿';
    document.getElementById('rExLbl').textContent='ทุนโรคร้ายแรง';
    document.getElementById('rEx').className=exCls.leg;
    document.getElementById('rEx').textContent=ciB+' ฿';
    document.getElementById('rCov').textContent='98 ปี';
    document.getElementById('rAcc').textContent='20-65 ปี';
    document.getElementById('covList').innerHTML=`
      <div class="cov"><div class="ck">✓</div><div>ทุนชีวิต ${lL} ส่งต่อให้ทายาท</div></div>
      <div class="cov"><div class="ck">✓</div><div>โรคร้ายแรง ${ciB} บาท ครอบคลุม 50 โรค</div></div>
      <div class="cov"><div class="ck">✓</div><div>เบี้ยคงที่ตลอดสัญญา วางแผนการเงินได้ง่าย</div></div>
      <div class="cov"><div class="ck">✓</div><div>คุ้มครองชีวิตครบถ้วน ไม่มีผลรอดชีวิต</div></div>`;
    document.getElementById('ctaLine').className='cbtn cb-leg';
    document.getElementById('ctaAppt').className='cbtn cb-out-leg';
  } else {
    const pL=(pcAmt/1000000)+' ล้านบาท';
    const info=PC_INFO[pcAmt];
    document.getElementById('rPlan').textContent='FWD พรีเชียส แคร์ '+pL;
    document.getElementById('rFor').textContent=g+' อายุ '+age+' ปี';
    document.getElementById('rSumLbl').textContent='วงเงิน/ปี';
    document.getElementById('rSum').textContent=pL;
    document.getElementById('rLife').textContent=fmt(info.life)+' ฿';
    document.getElementById('rExLbl').textContent='วงเงินผู้ป่วยนอก';
    document.getElementById('rEx').className=exCls.pc;
    document.getElementById('rEx').textContent=fmt(info.opd)+' ฿/ครั้ง';
    document.getElementById('rCov').textContent='99 ปี';
    document.getElementById('rAcc').textContent='20-75 ปี';
    document.getElementById('covList').innerHTML=`
      <div class="cov"><div class="ck">✓</div><div>เหมาจ่าย ${pL}/ปี ไม่มีความรับผิดส่วนแรก</div></div>
      <div class="cov"><div class="ck">✓</div><div>ค่าห้อง ${fmt(info.room)} บาท/คืน (ไม่จำกัดวัน)</div></div>
      <div class="cov"><div class="ck">✓</div><div>ผู้ป่วยนอก ${fmt(info.opd)} บาท/ครั้ง</div></div>
      <div class="cov"><div class="ck">✓</div><div>ทุนชีวิต ${fmt(info.life)} บาท คุ้มครองถึงอายุ 99 ปี</div></div>`;
    document.getElementById('ctaLine').className='cbtn cb-pc';
    document.getElementById('ctaAppt').className='cbtn cb-out-pc';
  }

  document.getElementById('resSec').classList.add('show');
  setTimeout(()=>{document.getElementById('resSec').scrollIntoView({behavior:'smooth',block:'start'});},100);
}

function showQR(){
  document.getElementById('qrEl').style.display='block';
  setTimeout(()=>{document.getElementById('qrEl').scrollIntoView({behavior:'smooth',block:'center'});},100);
}

function openAppt(){
  document.getElementById('mbody').style.display='block';
  document.getElementById('ssEl').style.display='none';
  const age=document.getElementById('inAge').value;
  if(age){
    const mL=mode==='ci'?'CI '+(ciAmt>=1000000?ciAmt/1000000+'M':ciAmt):mode==='leg'?'มรดก '+(legAmt/1000000)+'M':'พรีเชียส '+(pcAmt/1000000)+'M';
    document.getElementById('aNote').value='สนใจแผน '+mL+' อายุ '+age+' ปี '+(gender==='male'?'ชาย':'หญิง');
  }
  document.getElementById('apptMov').classList.add('show');
  document.body.style.overflow='hidden';
}

function closeAppt(){document.getElementById('apptMov').classList.remove('show');document.body.style.overflow='';}
function closeApptOut(e){if(e.target===document.getElementById('apptMov'))closeAppt();}

function submitAppt(){
  const n=document.getElementById('aName').value.trim();
  const p=document.getElementById('aPhone').value.trim();
  if(!n||!p){alert('กรุณากรอกชื่อและเบอร์โทรศัพท์ครับ');return;}
  document.getElementById('mbody').style.display='none';
  document.getElementById('ssEl').style.display='block';
}

document.addEventListener('DOMContentLoaded',()=>{
  document.getElementById('inAge').addEventListener('keydown',e=>{if(e.key==='Enter')doSearch();});
  const t=new Date().toISOString().split('T')[0];
  document.getElementById('aDate').min=t;
});
</script>
</body>
</html>
